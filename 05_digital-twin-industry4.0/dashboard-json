ground:rgba(0,188,212,.04)!important;}\n.nr-dashboard-theme .nr-dashboard-gauge svg text{fill:var(--text)!important;}\n.nr-dashboard-theme .nr-dashboard-chart svg text{fill:var(--text)!important;}\n.nr-dashboard-theme .nr-dashboard-chart .nv-axis path,.nr-dashboard-theme .nr-dashboard-chart .nv-axis line{stroke:rgba(255,255,255,.15)!important;}\n.scada-header{background:linear-gradient(135deg,#0a1929,#1b263b);border-bottom:3px solid var(--accent);padding:14px 22px;display:flex;justify-content:space-between;align-items:center;color:#fff;border-radius:8px;margin-bottom:6px;}\n.kpi-tile{background:linear-gradient(145deg,#152238,#0d1b2a);border:1px solid rgba(0,188,212,.35);border-radius:12px;padding:14px 16px;text-align:left;box-shadow:0 4px 18px rgba(0,0,0,.5),0 0 0 1px rgba(0,188,212,.08) inset;position:relative;overflow:hidden;height:100%;}\n.kpi-tile::before{content:'';position:absolute;top:0;left:0;height:3px;width:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));}\n.kpi-tile .label{color:var(--muted);font-size:11px;letter-spacing:1.4px;text-transform:uppercase;font-weight:600;}\n.kpi-tile .value{font-family:'JetBrains Mono','Consolas',monospace;font-size:30px;font-weight:700;color:var(--accent);line-height:1.1;margin-top:6px;}\n.kpi-tile .value small{font-size:14px;color:var(--muted);font-weight:500;margin-left:4px;}\n.kpi-tile .sub{font-size:11px;color:var(--muted);margin-top:4px;}\n.kpi-tile.ok .value{color:var(--ok);}.kpi-tile.warn .value{color:var(--warn);}.kpi-tile.err .value{color:var(--err);}\n.led{width:14px;height:14px;border-radius:50%;display:inline-block;box-shadow:0 0 12px currentColor;animation:pulse 2s infinite;}\n@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.65;transform:scale(.92);}}\n.badge{display:inline-block;padding:3px 9px;border-radius:10px;font-size:10px;letter-spacing:1px;font-weight:700;}\n.badge.ok{background:rgba(76,175,80,.18);color:var(--ok);border:1px solid var(--ok);}\n.badge.warn{background