        "func": "function f32(arr,i){if(!arr||arr.length<i+2)return NaN;const b=Buffer.alloc(4);b.writeUInt16BE(arr[i]||0,0);b.writeUInt16BE(arr[i+1]||0,2);const v=b.readFloatBE(0);return isFinite(v)?v:0;}\nconst r=msg.payload;\nflow.set('lastSeen_v',Date.now());\nconst Vab=f32(r,0),Vbc=f32(r,2),Vca=f32(r,4),Vavg_LL=f32(r,6);\nconst Van=f32(r,8),Vbn=f32(r,10),Vcn=f32(r,12),Vavg_LN=f32(r,16);\nflow.set('Vab',Vab);flow.set('Vbc',Vbc);flow.set('Vca',Vca);flow.set('Vavg_LL',Vavg_LL);\nflow.set('Van',Van);flow.set('Vbn',Vbn);flow.set('Vcn',Vcn);flow.set('Vavg_LN',Vavg_LN);\nconst arrLL=[Vab,Vbc,Vca].filter(x=>x>0);\nconst maxLL=Math.max(...arrLL,0),minLL=Math.min(...arrLL,maxLL);\nflow.set('V_unbalance',maxLL>0?((maxLL-minLL)/maxLL*100):0);\nreturn [\n  {topic:'Vab',payload:Vab},{topic:'Vbc',payload:Vbc},{topic:'Vca',payload:Vca},{topic:'Vavg_LL',payload:Vavg_LL},\n  {topic:'Van',payload:Van},{topic:'Vbn',payload:Vbn},{topic:'Vcn',payload:Vcn},{topic:'Vavg_LN',payload:Vavg_LN}\n];",
