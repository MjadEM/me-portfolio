    {
        "id": "a403580efef3c55d",
        "type": "function",
        "z": "3fcddd7b2d8eaf37",
        "name": "Decode THD (triangle)",
        "func": "// === Decode THD - reseau TRIANGLE sans neutre (PM2230) ===\n// Lecture brute : 28 registres depuis l'adresse 21300\n// Layout (float32 big-endian, 2 registres par valeur) :\n//   Bloc COURANT (base 21300) :\n//     offset 0  : THD Current A  (reg 21300-21301)\n//     offset 2  : THD Current B  (reg 21302-21303)\n//     offset 4  : THD Current C  (reg 21304-21305)\n//   Bloc TENSION COMPOSEE (base 21300) :\n//     offset 22 : THD Voltage A-B (reg 21322-21323)  <-- U12\n//     offset 24 : THD Voltage B-C (reg 21324-21325)  <-- U23\n//     offset 26 : THD Voltage C-A (reg 21326-21327)  <-- U31\n// NB: en triangle, les THD tension phase-neutre (21330+) ne sont pas pertinents.\n\nfunction f32(arr, i) {\n    if (!arr || arr.length < i + 2) return 0;\n    const b = Buffer.alloc(4);\n    b.writeUInt16BE(arr[i]   || 0, 0);\n    b.writeUInt16BE(arr[i+1] || 0, 2);\n    const v = b.readFloatBE(0);\n    return Number.isFinite(v) ? v : 0;\n}\n\nconst r = msg.payload;\nflow.set('lastSeen_thd', Date.now());\n\n// THD Tension composee (U12, U23, U31)\n// On garde les noms THD_Va/Vb/Vc pour compatibilite avec fn_kpi_aggregate,\n// mais ils representent ici U12, U23, U31 (et non phase-neutre).\nconst THD_Va = f32(r, 22);  // U12 (A-B)\nconst THD_Vb = f32(r, 24);  // U23 (B-C)\nconst THD_Vc = f32(r, 26);  // U31 (C-A)\n\n// THD Courant phase A, B, C\nconst THD_Ia = f32(r, 0);\nconst THD_Ib = f32(r, 2);\nconst THD_Ic = f32(r, 4);\n\n// Moyennes\nconst THD_Vavg = (THD_Va + THD_Vb + THD_Vc) / 3;\nconst THD_Iavg = (THD_Ia + THD_Ib + THD_Ic) / 3;\n\n// Stockage dans le flow context\nflow.set('THD_Va', THD_Va);\nflow.set('THD_Vb', THD_Vb);\nflow.set('THD_Vc', THD_Vc);\nflow.set('THD_Ia', THD_Ia);\nflow.set('THD_Ib', THD_Ib);\nflow.set('THD_Ic', THD_Ic);\nflow.set('THD_Vavg', THD_Vavg);\nflow.set('THD_Iavg', THD_Iavg);\n\nnode.status({fill:'green', shape:'dot',\n    text:`U:${THD_Vavg.toFixed(2)}%  I:${THD_Iavg.toFixed(2)}%`});\n\nreturn [\n    { topic:'THD_U', payload: THD_Vavg },\n    { topic:'THD_I', payload: THD_Iavg },\n    { payload: {\n        THD_Va: THD_Va, THD_Vb: THD_Vb, THD_Vc: THD_Vc,\n        THD_Ia: THD_Ia, THD_Ib: THD_Ib, THD_Ic: THD_Ic\n    }}\n];\n",
