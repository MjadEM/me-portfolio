    {
        "id": "725cf765045e3d2b",
        "type": "function",
        "z": "3fcddd7b2d8eaf37",
        "name": "Calcul Moteur",
        "func": "// === Calcul des grandeurs du moteur asynchrone ===\n// Entree : Hz (frequence reseau), Ptot (puissance active reseau)\n// Sortie : Ns synchrone, Nr rotor, glissement, couple, etat\n//\n// FIX: 4 sorties separees pour alimenter correctement les jauges (nombres)\n//      et les templates (objet complet).\n\nconst f    = flow.get('Hz') || 50;\nconst p    = flow.get('motor_poles') || 4;\nconst Ptot = flow.get('Ptot') || 0;\nconst eff  = flow.get('motor_eff') || 0.92;\nconst Pn   = flow.get('motor_Pn')  || 15;\n\nconst Ns      = (120 * f) / p;\nconst load    = Pn > 0 ? Math.abs(Ptot) / Pn : 0;\nconst slip    = Math.max(0, Math.min(0.06, load * 0.04));\nconst Nr      = Ns * (1 - slip);\nconst omega_r = 2 * Math.PI * Nr / 60;\nconst Pmech   = Math.abs(Ptot) * eff;\nconst couple  = omega_r > 0 ? (Pmech * 1000) / omega_r : 0;\n\nlet etat = 'ARRET', color = '#90a4ae';\nif      (Math.abs(Ptot) < 0.2) { etat = 'ARRET';        color = '#90a4ae'; }\nelse if (load < 0.4)           { etat = 'SOUS-CHARGE';  color = '#ff9800'; }\nelse if (load > 1.1)           { etat = 'SURCHARGE';    color = '#f44336'; }\nelse                           { etat = 'NORMAL';       color = '#4caf50'; }\n\n// Expose au flow context pour Agregation KPI / InfluxDB\nflow.set('Ns', Ns);\nflow.set('Nr', Nr);\nflow.set('slip', slip * 100);\nflow.set('couple_Nm', couple);\nflow.set('P_mech_kW', Pmech);\nflow.set('moteur_etat',  etat);\nflow.set('moteur_color', color);\nflow.set('moteur_load',  load * 100);\n\nconst objet = { Ns, Nr, slip: slip * 100, couple, Pmech, etat, color, load: load * 100 };\n\nnode.status({\n    fill: color === '#90a4ae' ? 'grey' : (etat === 'NORMAL' ? 'green' : 'yellow'),\n    shape: 'dot',\n    text: `${etat} Nr=${Nr.toFixed(0)}tr/min C=${couple.toFixed(1)}Nm`\n});\n\nreturn [\n    { payload: objet  },   // sortie 1 -> templates (Etat Moteur, Courbe T(N))\n    { topic: 'Ns',     payload: Ns },     // sortie 2 -> jauge Ns\n    { topic: 'Nr',     payload: Nr },     // sortie 3 -> jauge Nr + chart\n    { topic: 'Couple', payload: couple }, // sortie 4 -> jauge Couple\n];\n",
