    {
        "id": "c463057c84d9e993",
        "type": "function",
        "z": "3fcddd7b2d8eaf37",
        "name": "Decode Puissances",
        "func": "// Decode puissances depuis adresse 3053 (Schneider 3054 = Pa)\n// Topologie: triphase sans neutre (3-wire delta)\n// -> Pa/Pb/Pc, Qa/Qb/Qc, Sa/Sb/Sc, PFa/PFb/PFc seront NaN (physique normale)\n// -> Seuls Ptot, Qtot, Stot, PFtot sont valides\n\nfunction f32(arr, i) {\n    if (!arr || arr.length < i+2) return null;\n    const b = Buffer.alloc(4);\n    b.writeUInt16BE(arr[i] & 0xFFFF, 0);\n    b.writeUInt16BE(arr[i+1] & 0xFFFF, 2);\n    const v = b.readFloatBE(0);\n    return Number.isFinite(v) ? v : null;\n}\n\nconst r = msg.payload;\n\nconst ctx = {\n    Pa: f32(r, 0),   Pb: f32(r, 2),   Pc: f32(r, 4),\n    P: f32(r, 6),    Ptot: f32(r, 6),\n    Qa: f32(r, 8),   Qb: f32(r, 10),  Qc: f32(r, 12),\n    Q: f32(r, 14),   Qtot: f32(r, 14),\n    Sa: f32(r, 16),  Sb: f32(r, 18),  Sc: f32(r, 20),\n    S: f32(r, 22),   Stot: f32(r, 22),\n    PFa: f32(r, 24), PFb: f32(r, 26), PFc: f32(r, 28),\n    PF: f32(r, 30),  PFtot: f32(r, 30),\n};\n\nflow.set('powers', ctx);\n\n// Exposer chaque cle au niveau flow context pour Agregation KPI\nfor (const k in ctx) {\n    if (ctx[k] !== null && Number.isFinite(ctx[k])) flow.set(k, ctx[k]);\n}\nflow.set('lastSeen_p', Date.now());\nflow.set('lastSeen_powers', Date.now());\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: `P=${ctx.P!=null?ctx.P.toFixed(3):'NaN'}kW PF=${ctx.PF!=null?ctx.PF.toFixed(2):'NaN'}`\n});\n\n// FIX CRITIQUE: retourner 4 messages separes (1 par sortie)\n// Sortie 1 -> jauge P + chart P/Q/S + chart Tendance P\n// Sortie 2 -> jauge Q + chart P/Q/S\n// Sortie 3 -> jauge S + chart P/Q/S\n// Sortie 4 -> jauge PF (cos phi)  <-- corrige le bug \"PF bloque a 0.000\"\nreturn [\n    { topic: 'P',  payload: ctx.Ptot  != null ? ctx.Ptot  : 0 },\n    { topic: 'Q',  payload: ctx.Qtot  != null ? ctx.Qtot  : 0 },\n    { topic: 'S',  payload: ctx.Stot  != null ? ctx.Stot  : 0 },\n    { topic: 'PF', payload: ctx.PFtot != null ? ctx.PFtot : 0 }\n];\n",
