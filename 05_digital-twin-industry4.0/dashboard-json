        "z": "3fcddd7b2d8eaf37",
        "name": "Détection Alarmes",
        "func": "const Vavg=flow.get('Vavg_LN')||0;\nconst Iavg=flow.get('Iavg')||0;\nconst PF=flow.get('PFtot')||1;\nconst Hz=flow.get('Hz')||50;\nconst THD_V=flow.get('THD_Vavg')||0;\nconst THD_I=flow.get('THD_Iavg')||0;\nconst V_unb=flow.get('V_unbalance')||0;\nconst I_unb=flow.get('I_unbalance')||0;\nconst comm=flow.get('commStatus')||'offline';\nconst sV=flow.get('seuil_V_max')||253;\nconst sVmin=flow.get('seuil_V_min')||207;\nconst sI=flow.get('seuil_I_max')||80;\nconst sPF=flow.get('seuil_PF_min')||0.85;\nconst sTHD=flow.get('seuil_THD')||8;\nconst sUnb=flow.get('seuil_unb')||5;\nconst alarms=[];\nfunction add(level,code,msg,val){alarms.push({level,code,msg,val,ts:new Date().toLocaleTimeString('fr-FR')});}\nif(comm==='offline')add('err','COM-01','Communication Modbus perdue','');\nelse if(comm==='degraded')add('warn','COM-02','Communication dégradée','');\nif(Vavg>0&&Vavg>sV)add('err','V-01','Surtension réseau',Vavg.toFixed(1)+' V');\nif(Vavg>0&&Vavg<sVmin)add('err','V-02','Sous-tension réseau',Vavg.toFixed(1)+' V');\nif(Iavg>sI)add('err','I-01','Surintensité',Iavg.toFixed(1)+' A');\nif(PF>0&&PF<sPF)add('warn','PF-01','Facteur de puissance faible',PF.toFixed(3));\nif(Hz>0&&(Hz<49||Hz>51))add('warn','F-01','Fréquence hors plage',Hz.toFixed(2)+' Hz');\nif(THD_V>sTHD)add('warn','THD-V','Distorsion tension élevée',THD_V.toFixed(1)+' %');\nif(THD_I>sTHD*2)add('warn','THD-I','Distorsion courant élevée',THD_I.toFixed(1)+' %');\nif(V_unb>sUnb)add('warn','UNB-V','Déséquilibre tension',V_unb.toFixed(1)+' %');\nif(I_unb>sUnb*3)add('warn','UNB-I','Déséquilibre courant',I_unb.toFixed(1)+' %');\nconst nbErr=alarms.filter(a=>a.level==='err').length;\nconst nbWarn=alarms.filter(a=>a.level==='warn').length;\nflow.set('alarms',alarms);\nflow.set('nbErr',nbErr);\nflow.set('nbWarn',nbWarn);\nconst hist=context.get('alarm_history')||[];\nconst lastKey=context.get('last_alarm_key')||'';\nconst key=alarms.map(a=>a.code).join(',');\nif(key!==lastKey&&alarms.length>0){alarms.forEach(a=>{hist.unshift(Object.assign({},a));});if(hist.length>50)hist.length=50;context.set('alarm_history',hist);context.set('last_alarm_key',key);}\nflow.set('alarm_history',hist);\nreturn [{payload:{active:alarms,nbErr,nbWarn,nbTotal:alarms.length}},{payload:hist},{payload:{nbErr,nbWarn,nbTotal:alarms.length}}];",
