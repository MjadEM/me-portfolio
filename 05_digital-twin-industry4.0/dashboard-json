    {
        "id": "b84687835ad20f1c",
        "type": "function",
        "z": "3fcddd7b2d8eaf37",
        "name": "→ Long Schema (InfluxDB v2)",
        "func": "// =========================================================================\n// PM2230 → InfluxDB v2 : transformateur wide→long schema\n// Entrée  : msg.payload = {Van,Vbn,Vcn,Vab,Vbc,Vca,Vavg_LN,Vavg,Ia,Ib,Ic,In,Iavg,\n//                          P,Q,S,PF,E,Hz,Pa,Pb,Pc,THD_V,THD_I,V_unb,I_unb,...}\n// Sortie  : msg.payload = [ {measurement, tags, fields, timestamp}, ... ]\n// Cible   : node \"influxdb batch\" (multi-measurement par appel)\n// =========================================================================\nconst d = msg.payload || {};\nconst now = Date.now();\nconst points = [];\n\n// Filtre numérique strict (pas de NaN, pas d'undefined, pas de null)\nconst num = v => (typeof v === 'number' && Number.isFinite(v)) ? v : null;\n\n// Helper : pousse un point uniquement si AU MOINS un field exploitable\nconst push = (measurement, tags, fieldsObj) => {\n    const fields = {};\n    for (const k in fieldsObj) {\n        const v = num(fieldsObj[k]);\n        if (v !== null) fields[k] = v;\n    }\n    if (Object.keys(fields).length === 0) return;\n    points.push({ measurement, tags, fields, timestamp: now });\n};\n\n// ---------- Tensions Ligne-Neutre (V) ----------\npush('voltage', { phase: 'a',   type: 'ln' }, { value: d.Van });\npush('voltage', { phase: 'b',   type: 'ln' }, { value: d.Vbn });\npush('voltage', { phase: 'c',   type: 'ln' }, { value: d.Vcn });\npush('voltage', { phase: 'avg', type: 'ln' }, { value: d.VavgLN });\n\n// ---------- Tensions Ligne-Ligne (V) ----------\npush('voltage', { phase: 'ab',  type: 'll' }, { value: d.Vab });\npush('voltage', { phase: 'bc',  type: 'll' }, { value: d.Vbc });\npush('voltage', { phase: 'ca',  type: 'll' }, { value: d.Vca });\npush('voltage', { phase: 'avg', type: 'll' }, { value: d.Vavg });\n\n// ---------- Courants (A) ----------\npush('current', { phase: 'a'   }, { value: d.Ia });\npush('current', { phase: 'b'   }, { value: d.Ib });\npush('current', { phase: 'c'   }, { value: d.Ic });\npush('current', { phase: 'n'   }, { value: d.In });\npush('current', { phase: 'avg' }, { value: d.Iavg });\n\n// ---------- Puissances par phase (W / VAR) ----------\npush('power', { phase: 'a' }, { p: d.Pa });\npush('power', { phase: 'b' }, { p: d.Pb });\npush('power', { phase: 'c' }, { p: d.Pc });\n\n// ---------- Puissances totales (W / VAR / VA / pu) ----------\npush('power', { phase: 'total' }, {\n    p:  d.P,\n    q:  d.Q,\n    s:  d.S,\n    pf: d.PF\n});\n\n// ---------- Énergie cumulée (kWh) ----------\npush('energy', {}, { kwh: d.E });\n\n// ---------- Fréquence (Hz) ----------\npush('frequency', {}, { value: d.Hz });\n\n// ---------- Qualité : THD (%) ----------\npush('thd', { signal: 'voltage' }, { value: d.THD_V });\npush('thd', { signal: 'current' }, { value: d.THD_I });\n\n// ---------- Qualité : Déséquilibre (%) ----------\npush('unbalance', { signal: 'voltage' }, { value: d.V_unb });\npush('unbalance', { signal: 'current' }, { value: d.I_unb });\n\n// ---------- État communication Modbus ----------\nconst commState = (d.commText || 'INIT').toString().toUpperCase();\npoints.push({\n    measurement: 'comm_status',\n    tags: { state: commState.toLowerCase() },\n    fields: {\n        ok:       commState === 'OK' ? 1 : 0,\n        errors:   Number(d.nbErr)  || 0,\n        warnings: Number(d.nbWarn) || 0\n    },\n    timestamp: now\n});\n\nmsg.payload = points;\nnode.status({\n    fill:  points.length >= 24 ? 'green' : 'yellow',\n    shape: 'dot',\n    text:  `${points.length} pts @ ${new Date(now).toLocaleTimeString('fr-FR')}`\n});\nreturn msg;\n",
